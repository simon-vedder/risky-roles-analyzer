<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>RiskyRolesAnalyzer.RiskyRoleAssignment</Name>
      <ViewSelectedBy>
        <TypeName>RiskyRolesAnalyzer.RiskyRoleAssignment</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Severity</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Score</Label><Width>5</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Where</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Role</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Principal</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Scope</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Assignment</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Activity</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Protected</Label><Width>9</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Severity</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RiskScore</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RoleScope</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RoleName</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.ViaGroup) { "$($_.PrincipalName) (via $($_.ViaGroup))" } else { $_.PrincipalName }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>PrincipalType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ScopeLevel</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AssignmentType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ActivityStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Protected</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>RiskyRolesAnalyzer.RiskyRoleAssignmentRemoval</Name>
      <ViewSelectedBy>
        <TypeName>RiskyRolesAnalyzer.RiskyRoleAssignmentRemoval</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Result</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Where</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Role</Label><Width>28</Width></TableColumnHeader>
          <TableColumnHeader><Label>Principal</Label><Width>30</Width></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Result</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RoleScope</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RoleName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PrincipalName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Reason</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
